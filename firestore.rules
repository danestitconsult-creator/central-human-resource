rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roleIs(r) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == r;
    }

    // A "lead" can read every monitor's checks. "hr" can read every check, add evidence to any check, and upload the nominal roll.
    // Roles can only be changed from the Firebase console (see README), never from the app.
    function isLead() { return roleIs('lead'); }
    function isHr()   { return roleIs('hr'); }

    function ownsInspection(inspectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/inspections/$(inspectionId))
        && get(/databases/$(database)/documents/inspections/$(inspectionId)).data.ownerId == request.auth.uid;
    }

    // User profiles: everyone starts as a 'monitor' and cannot change their own role.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'monitor';
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Shared dropdown list of institutions (any signed-in user can read, add and remove names).
    // To restrict editing to team leads, change `write` below to: if isLead();
    match /config/institutions {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // HR nominal roll: one document per institution. Everyone signed in can read it (monitors need it to cross-check
    // staff on site); only HR can upload or replace it. It holds names, employee numbers and jobs only.
    match /roll/{key} {
      allow read: if signedIn();
      allow write: if isHr();
    }

    // Inspections: owners have full access; leads and HR can read everyone's checks (read-only).
    match /inspections/{inspectionId} {
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow read:   if signedIn()
                    && (resource.data.ownerId == request.auth.uid || isLead() || isHr());
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn()
                    && resource.data.ownerId == request.auth.uid;

      // Evidence of the visit (photos and short PDFs). The check's owner and HR can add; leads can view.
      // Files are removed by whoever uploaded them, the check's owner, or HR. Files cannot be edited, only replaced.
      match /evidence/{evidenceId} {
        allow read:   if signedIn() && (ownsInspection(inspectionId) || isLead() || isHr());
        allow create: if signedIn()
                      && request.resource.data.uploadedBy == request.auth.uid
                      && request.resource.data.kind in ['image', 'pdf']
                      && (ownsInspection(inspectionId) || isHr());
        allow update: if false;
        allow delete: if signedIn()
                      && (resource.data.uploadedBy == request.auth.uid || ownsInspection(inspectionId) || isHr());
      }
    }
  }
}
